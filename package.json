{
  "name": "tradeflow",
  "version": "0.1.0",
  "private": true,
  "description": "A small stock portfolio ledger for the Dhaka Stock Exchange: transactions, holdings, P/L and the owner's own rules, on synthetic data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --ignore-pattern 'vendor/**'",
    "test": "vitest run",
    "seed": "node scripts/seed.mjs",
    "db:load": "node scripts/load-postgres.mjs",
    "agent": "node --env-file-if-exists=.env --import tsx scripts/agent.ts",
    "try-model": "node --env-file-if-exists=.env --import tsx scripts/try-model.ts",
    "parity": "node --env-file-if-exists=.env --import tsx scripts/parity.ts",
    "make-fixtures": "node --import tsx scripts/make-fixtures.ts",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/eval.ts",
    "e2e:live": "node --env-file-if-exists=.env --import tsx scripts/e2e-live.ts",
    "metrics": "node --env-file-if-exists=.env --import tsx scripts/metrics.ts",
    "check": "npm run lint && tsc --noEmit && npm test && npm run eval -- --no-results && npm run eval -- --no-results --concurrency 3",
    "mcp": "node --env-file-if-exists=.env --import tsx scripts/mcp-server.ts",
    "mcp-smoke": "node --env-file-if-exists=.env --import tsx scripts/mcp-smoke.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "next": "16.2.4",
    "openai": "^7.42.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.5"
  }
}
