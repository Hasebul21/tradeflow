# Nothing here is needed for `npm run dev`. Copy to .env only for what you use.

# Broker commission as a decimal (0.004 = 0.4%, the DSE norm).
NEXT_PUBLIC_TRADE_COMMISSION_RATE=0.004
# Where the JSON data files live. Defaults to ./data in the project root.
TRADEFLOW_DATA_DIR=./data
# Last trading day of the generated data for `npm run seed`. Defaults to 2026-10-01.
SEED_END_DATE=
# Password for the postgres superuser in docker-compose.yml.
PGPASS=
# Server that `npm run db:load` writes to, e.g. postgres://postgres:<PGPASS>@localhost:5432/postgres
DATABASE_URL=
# The same server as an outside reader (such as Zetaris) reaches it; not used by any script here.
DATABASE_URL_EXTERNAL=
# Password for the read-only role zetaris_ro; leave empty to skip creating the role.
ZETARIS_DB_PASSWORD=

# Agent layer. Empty SAMPLE_MODE: the real model when the key, base URL and all three model ids are set, otherwise sample mode.
# true forces sample mode; false forces the real model and fails when one of them is missing.
SAMPLE_MODE=
# Meterless Nightshift runtime token (not an NVIDIA key; that lives in Nightshift's Providers tab).
METERLESS_API_KEY=
# Nightshift runtime URL from the Console. A trailing slash or /v1 is optional.
METERLESS_BASE_URL=
# Routing ids that GET <base>/models lists for each tier.
NEMOTRON_MODEL_STRONG=
NEMOTRON_MODEL_MAIN=
NEMOTRON_MODEL_FAST=
# Zetaris REST client. Queries run locally unless the URL, org id and API key are all set.
ZETARIS_REST_URL=
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
LOG_LEVEL=info
PORT=8000
