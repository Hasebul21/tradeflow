{
  "permissions": {
    "allow": [
            "Bash(grep:*)", 
      "Bash(tail:*)", 
      "Bash(date:*)", 
      "Bash(sleep:*)",
      "Bash(for:*)",
      "Bash(seq:*)",
      "Bash(printf:*)", 
      "Bash([:*)",
      "Bash(while:*)",
"Bash(until:*)",
"Bash(if:*)",
"Bash([[:*)",
"Bash(timeout:*)",
"Bash(wait:*)",
"Bash(echo:*)",
"Bash(test:*)",
"Bash(true)",
"Bash(false)",
"Bash(ls:*)",
"Bash(pwd)",
"Bash(wc:*)",
"Bash(head:*)",
"Bash(sort:*)",
"Bash(uniq:*)",
"Bash(cut:*)",
"Bash(tr:*)",
"Bash(basename:*)",
"Bash(dirname:*)",
"Bash(realpath:*)",
"Bash(stat:*)",
"Bash(file:*)",
"Bash(du:*)",
"Bash(df:*)",
"Bash(which:*)",
"Bash(type:*)",
"Bash(uname:*)",
"Bash(whoami)",
"Bash(diff:*)",
"Bash(jq:*)",
"Bash(awk:*)",
"Bash(rg:*)",
"Bash(git status:*)",
"Bash(git diff:*)",
"Bash(git log:*)",
 "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(npm install:*)"
      ],
    "deny": [
      "Read(./.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/secrets/**)",
      "Read(./.hackathon-prep/**)",
      "Read(./data/memory/**)",
      "Read(./logs/*.jsonl)"

    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-adapter.mjs read", "timeout": 10 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-adapter.mjs shell", "timeout": 10 }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-adapter.mjs prompt", "timeout": 10 }]
      }
    ]
  }
}
